{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "Only the bundled local launcher page receives IPC. The DSH webview has no capabilities.",
  "local": true,
  "windows": [
    "launcher"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-perform-action"
  ]
}
