{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "Only bundled local launcher and settings content receive service, settings and updater IPC. The DSH webview has no capabilities.",
  "local": true,
  "webviews": [
    "launcher",
    "launcher-settings",
    "dsh-settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-open-settings",
    "allow-perform-action",
    "allow-set-project-directory",
    "allow-get-update-snapshot",
    "allow-check-update",
    "allow-install-update",
    "allow-get-notification-snapshot",
    "allow-set-notifications-enabled",
    "allow-test-notification",
    "allow-get-power-snapshot",
    "allow-set-power-enabled"
  ]
}
