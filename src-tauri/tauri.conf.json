{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH WSL Desktop",
  "version": "0.1.2",
  "identifier": "io.local.dsh-wsl-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'",
      "capabilities": [
        "launcher"
      ]
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/elves-ai/dsh-wsl-desktop/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQTRBQUQwQTlCMTRDQUIKUldTclRMR3AwS3FrSzFDV0pCaDRkZktLWWhhMlhybytGWDV1bG14RDgwQ3BNNDcxMEIrTnJzczcK",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Evan Yang",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/elves-ai/dsh-wsl-desktop",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
